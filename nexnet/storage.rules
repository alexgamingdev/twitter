rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ── Profile Avatars ────────────────────────────────────────────────────
    // Public read; only the owner may upload their own avatar (max 5 MB, images only).
    match /avatars/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

    // ── Profile Banners ────────────────────────────────────────────────────
    // Public read; only the owner may upload their own banner (max 8 MB, images only).
    match /banners/{uid} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.uid == uid
                   && request.resource.size < 8 * 1024 * 1024
                   && request.resource.contentType.matches('image/.*');
    }

  }
}
